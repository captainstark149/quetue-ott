<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="que-content-wrap">
    <!-- Channel Banner -->
    <div style="width:100%; height:180px; border-radius: var(--radius-card); overflow:hidden; margin-bottom: 24px; position:relative;">
      <img src="<%= user.banner || 'https://images.unsplash.com/photo-1579546929518-9e396f3cc809?auto=format&fit=crop&w=1200&q=80' %>" style="width:100%; height:100%; object-fit:cover;" alt="Banner" />
    </div>

    <!-- Channel Profile Header -->
    <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:20px; margin-bottom: 28px; border-bottom:1px solid var(--border-light); padding-bottom: 24px;">
      <div style="display:flex; align-items:center; gap: 20px;">
        <img src="<%= user.avatar %>" style="width: 80px; height: 80px; border-radius: 50%; object-fit: cover; border: 3px solid var(--que-blue);" alt="Avatar" />
        <div>
          <h1 style="font-size: 1.5rem; font-weight: 800;"><%= user.username %> <span class="up-badge">UP</span></h1>
          <p style="color: var(--text-muted); font-size: 0.88rem;"><%= user.handle %> • <%= user.subscribers.toLocaleString() %> followers</p>
        </div>
      </div>

      <button class="btn-subscribe" style="padding: 10px 28px; font-size: 0.95rem;">+ Subscribe</button>
    </div>

    <!-- Uploaded Videos Grid -->
    <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 20px;">
      <i class="fa-solid fa-play" style="color:var(--que-blue)"></i> Submissions (<%= videos.length %>)
    </h3>

    <div class="que-cards-grid">
      <% if (videos && videos.length > 0) { %>
        <% videos.forEach(video => { %>
          <a href="/watch/<%= video.id %>" class="que-video-card">
            <div class="que-card-thumb-wrap">
              <img src="<%= video.thumbnail_url %>" alt="<%= video.title %>" />
              <div class="que-thumb-stats-overlay">
                <span class="que-duration-badge"><%= video.duration %></span>
              </div>
            </div>
            <div class="que-card-info">
              <div class="que-card-title"><%= video.title %></div>
              <div class="que-up-meta">
                <span><%= new Date(video.created_at).toLocaleDateString() %></span>
              </div>
            </div>
          </a>
        <% }); %>
      <% } else { %>
        <div style="grid-column: 1 / -1; text-align: center; padding: 40px; background: var(--bg-subtle); border-radius: var(--radius-card);">
          <p style="color: var(--text-muted);">This creator hasn't uploaded any videos yet.</p>
        </div>
      <% } %>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
