<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="que-container">
    <div style="display: flex; gap: 24px;">
      <!-- Left Sidebar Navigation -->
      <%- include('partials/sidebar') %>

      <!-- Right Main Area -->
      <main style="flex: 1; min-width: 0;">
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
          <h2 style="font-size: 1.25rem; font-weight: 800; margin: 0; color: var(--text-main);">
            <% if (query) { %>
              Search Results for "<span style="color:var(--que-pink);"><%= query %></span>"
            <% } else { %>
              All Available Content
            <% } %>
          </h2>
          <% if (videos && videos.length > 0) { %>
            <span style="background: rgba(255, 102, 153, 0.12); color: var(--que-pink); font-size: 0.82rem; font-weight: 700; padding: 4px 12px; border-radius: 20px;">
              <%= videos.length %> <%= videos.length === 1 ? 'Result' : 'Results' %> Found
            </span>
          <% } %>
        </div>

        <!-- Direct Matches Section -->
        <% if (videos && videos.length > 0) { %>
          <div class="recommendations-grid">
            <% videos.forEach(video => { %>
              <a href="/watch/<%= video.id %>" class="recommended-card-item" aria-label="<%= video.title %>">
                <div class="recommended-thumb-wrap">
                  <img src="<%= video.thumbnail_url %>" alt="<%= video.title %>" onerror="this.src='https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&fit=crop&w=400&q=80'" />
                </div>
                <div class="recommended-card-info">
                  <div class="recommended-card-title" title="<%= video.title %>"><%= video.title %></div>
                </div>
              </a>
            <% }); %>
          </div>
        <% } else { %>
          <div style="text-align: center; padding: 40px 20px; background: rgba(255, 102, 153, 0.05); border: 2px dashed rgba(255, 102, 153, 0.25); border-radius: 16px; margin-bottom: 32px;">
            <i class="fa-solid fa-magnifying-glass-minus" style="font-size: 2.8rem; color: var(--que-pink); margin-bottom: 12px;"></i>
            <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 6px; color: var(--text-main);">No direct match found for "<%= query %>"</h3>
            <p style="color: var(--text-muted); font-size: 0.88rem; margin: 0;">Try searching for other titles, categories, or keywords below.</p>
          </div>
        <% } %>

        <!-- Related Movies & Shows Section -->
        <% if (typeof relatedVideos !== 'undefined' && relatedVideos && relatedVideos.length > 0) { %>
          <div style="margin-top: 36px; border-top: 1px solid var(--border-light); padding-top: 20px;">
            <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; color: var(--text-main);">
              <i class="fa-solid fa-fire" style="color:var(--que-pink);"></i> Related Movies & Shows You Might Like
            </h3>
            <div class="recommendations-grid">
              <% relatedVideos.forEach(rel => { %>
                <a href="/watch/<%= rel.id %>" class="recommended-card-item" aria-label="<%= rel.title %>">
                  <div class="recommended-thumb-wrap">
                    <img src="<%= rel.thumbnail_url %>" alt="<%= rel.title %>" onerror="this.src='https://images.unsplash.com/photo-1536440136628-849c177e76a1?auto=format&fit=crop&w=400&q=80'" />
                  </div>
                  <div class="recommended-card-info">
                    <div class="recommended-card-title" title="<%= rel.title %>"><%= rel.title %></div>
                  </div>
                </a>
              <% }); %>
            </div>
          </div>
        <% } %>
      </main>
    </div>
  </div>

  <%- include('partials/footer') %>
</body>
</html>
